{
  "rewrites": [
    {
      "source": "/dl-guide",
      "destination": "/dl-guide/index.html"
    },
    {
      "source": "/dl-guide/",
      "destination": "/dl-guide/index.html"
    },
    {
      "source": "/gnri/:path*",
      "destination": "https://gnri.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
